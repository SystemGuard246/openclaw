# OpenClaw Environment Configuration
# Copy to .env and fill in your values

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API Key (required — Claude Pro is restricted for third-party harnesses)
# Get yours at: console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Comma-separated Telegram chat IDs allowed to use the bot
# Leave empty to allow all (not recommended for personal bots)
# Find your chat ID by messaging @userinfobot on Telegram
TELEGRAM_ALLOWED_IDS=

# Your personal chat ID for proactive heartbeat messages
TELEGRAM_OWNER_CHAT_ID=
