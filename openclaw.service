[Unit]
Description=OpenClaw — Persistent AI Agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=aurumbot
WorkingDirectory=/home/aurumbot/openclaw
ExecStart=/home/aurumbot/.npm-global/bin/bun index.ts
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/aurumbot/openclaw/logs/openclaw.log
StandardError=append:/home/aurumbot/openclaw/logs/openclaw.log
SyslogIdentifier=openclaw

# Environment loaded from .env (- prefix means OK if missing)
EnvironmentFile=-/home/aurumbot/openclaw/.env

# Doctor auto-fix on crash
ExecStopPost=/home/aurumbot/.npm-global/bin/bun doctor.ts --fix

[Install]
WantedBy=multi-user.target
